# Firebase web app configuration. These values are public client identifiers,
# not service-account credentials. Do not add a real .env file to source control.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional Web App Check provider key. Register the web app first, monitor
# requests, then enforce App Check in Firebase only after device validation.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Local-only emulator controls. Leave false for normal Firebase use.
VITE_FIREBASE_USE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_EMULATOR_PORT=8082
VITE_FIREBASE_AUTH_USE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
